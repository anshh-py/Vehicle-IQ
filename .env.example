# Copy this file to the project root as .env and set your local PostgreSQL URL.
# Do not commit .env or put real credentials in this example file.
# For production, also set APP_ENV=production, API_ACCESS_TOKEN (32+ random
# characters), and IMAGE_STORAGE_DIR to an absolute path on a persistent volume.
DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/vehicle_iq
MAX_IMAGE_UPLOAD_BYTES=10485760
# Optional shared API bearer token. Set a strong random value before public
# deployment; production mode refuses API traffic if this setting is absent.
# API_ACCESS_TOKEN=
# API_RATE_LIMIT_PER_MINUTE=600
# MAX_EXTERNAL_RESPONSE_BYTES=2097152
# Optional LangSearch discovery only; results are not verified market listings.
# Set LANGSEARCH_API_KEY locally from the LangSearch dashboard. Never commit it.
# LANGSEARCH_TIMEOUT_SECONDS=20
# LANGSEARCH_RESULT_LIMIT=10
# Optional; defaults to the project-root .local-storage/vehicle-images directory.
# IMAGE_STORAGE_DIR=.local-storage/vehicle-images
# Set this to the extracted OCR service base URL when the service is running.
# OCR_SERVICE_URL=http://127.0.0.1:7860
# To use the public Baidu Hugging Face Gradio Space, set:
# OCR_SERVICE_PROVIDER=huggingface_gradio
# OCR_GRADIO_SPACE_URL=https://baidu-unlimited-ocr.hf.space
# OCR_GRADIO_MODE=gundam  # or base
# To use the local CPU PaddleOCR models, set the provider below. The model
# directories default to the git-ignored .local-storage/paddleocr-smoke-bos cache.
# OCR_SERVICE_PROVIDER=paddleocr_local
# OCR_PADDLE_DETECTION_MODEL_DIR=.local-storage/paddleocr-smoke-bos/paddlex/official_models/PP-OCRv5_mobile_det
# OCR_PADDLE_RECOGNITION_MODEL_DIR=.local-storage/paddleocr-smoke-bos/paddlex/official_models/en_PP-OCRv5_mobile_rec
# Damage detection uses the separate CPU-only environment and local checkpoint.
# Defaults point to .local-storage/damage-poc/.venv/Scripts/python.exe and
# .local-storage/damage-poc/trained.pt; override only if those paths differ.
# DAMAGE_INFERENCE_PYTHON=.local-storage/damage-poc/.venv/Scripts/python.exe
# DAMAGE_CHECKPOINT_PATH=.local-storage/damage-poc/trained.pt
# DAMAGE_INFERENCE_TIMEOUT_SECONDS=180
# Price estimates use this local research artifact by default; no model is
# downloaded automatically. Override if your research checkout is elsewhere.
# PRICE_MODEL_PATH=C:\Users\ansha\vehicle-iq-model-research\artifacts\vehicle_iq_price_model.joblib

# Supplied VehicleX endpoint candidate. Disabled until its authorization and
# response contract are independently confirmed. No credentials are assumed.
# VEHICLE_LOOKUP_ENABLED=false
# VEHICLE_LOOKUP_BASE_URL=https://vehiclex.profilework239.workers.dev/
# VEHICLE_LOOKUP_TIMEOUT_SECONDS=10

# Challan and FASTag endpoint candidates. Keep disabled until authorized and
# their live response contracts are confirmed. No credentials are assumed.
# CHALLAN_LOOKUP_ENABLED=false
# CHALLAN_LOOKUP_BASE_URL=https://challan-info-new-abhigyan.vercel.app/challaninfo
# CHALLAN_LOOKUP_TIMEOUT_SECONDS=10
# FASTAG_LOOKUP_ENABLED=false
# FASTAG_LOOKUP_BASE_URL=https://abhigyan-fastag-info.vercel.app/vehtofastaginfo
# FASTAG_LOOKUP_TIMEOUT_SECONDS=10
