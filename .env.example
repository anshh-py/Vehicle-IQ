
DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/vehicle_iq
APP_ENV=development
API_ACCESS_TOKEN=
IMAGE_STORAGE_PROVIDER=local
IMAGE_STORAGE_DIR=.local-storage/vehicle-images
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=vehicle-images
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_TIMEOUT_SECONDS=30
OCR_SERVICE_PROVIDER=baidu_unlimited_ocr
OCR_SERVICE_URL=
